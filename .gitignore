# --- Python Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# --- Virtual Environments ---
.venv/
venv/
env/

# --- MLflow Local Tracking & Database ---
# Exclude the local database and the run data folder
mlruns/
mlartifacts/
mlflow.db
*.db-shm
*.db-wal

# --- Model Weights & Checkpoints ---
# We ignore the actual weights to keep the repo small
*.pth
*.pt
checkpoints/

# --- Training Logs & Temporary Data ---
# Exclude local numpy logs and the logs folder you created
logs/
*.npy
*.npz
*.log

# --- Outputs & Visualization Results ---
# Exclude generated plots to keep the repo clean
outputs/
training_results.png

# --- IDE & System Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Requirements & Configs ---
# DO NOT ignore these; they are essential for reproducibility
# !requirements.txt
# !configs/